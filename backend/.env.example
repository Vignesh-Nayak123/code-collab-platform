# Backend environment variables. Copy to .env for local use (it's gitignored);
# on Render these are set by render.yaml / the dashboard. Placeholders only:
# never commit real values.

# Spring profiles. Free-tier demo: prod,demo (no Kafka, no code execution).
SPRING_PROFILES_ACTIVE=prod,demo

# HTTP port. Render injects PORT automatically; SERVER_PORT overrides it.
# SERVER_PORT=8080

# PostgreSQL: either a full JDBC URL...
# DB_URL=jdbc:postgresql://localhost:5432/codeeditor
# ...or the parts (used when DB_URL is unset):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codeeditor
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Redis: either a URL (takes precedence; rediss:// for TLS)...
# SPRING_DATA_REDIS_URL=redis://localhost:6379
# ...or host/port/password:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Code execution: kafka | inline | disabled. The demo profile defaults to disabled.
# inline/kafka need a Docker daemon (they start sandbox containers); never enable
# them on a host that can't isolate user code.
EXECUTION_MODE=disabled
# Only used when EXECUTION_MODE=kafka:
# KAFKA_SERVERS=localhost:9092

# Browser origins allowed for REST + WebSocket, comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://your-app.vercel.app

# JVM flags (the Dockerfile default is -XX:MaxRAMPercentage=75.0).
# JAVA_OPTS=-Xmx224m -Xss512k -XX:MaxMetaspaceSize=160m -XX:+UseSerialGC -XX:TieredStopAtLevel=1
