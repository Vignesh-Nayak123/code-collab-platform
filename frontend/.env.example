# Frontend build-time variables (Vite inlines VITE_* into the bundle at build time,
# so they're public, and changing them requires a rebuild/redeploy).
# Copy to .env.local for local overrides; on Vercel set them under
# Project Settings -> Environment Variables.
#
# Leave both unset for same-origin setups (vite dev proxy, nginx in docker-compose).

# REST API base, including /api/v1, no trailing slash.
VITE_API_URL=https://your-backend.onrender.com/api/v1

# SockJS/STOMP endpoint. Use https:// (SockJS negotiates the wss:// upgrade itself);
# ws:// and wss:// are accepted and converted.
VITE_WS_URL=https://your-backend.onrender.com/ws
